{
	"jsPlugins": [{ "name": "oxc-config", "specifier": "./plugin.mjs" }],
	"rules": {
		"oxc-config/jsx-no-conditional-leak": "error",
		"oxc-config/no-nested-links": "error",
		"oxc-config/no-unnecessary-usestate-type": "error"
	},
	"overrides": [
		{
			"files": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
			"rules": {
				"react/error-boundaries": "off",
				"react/exhaustive-deps": "off",
				"react/globals": "off",
				"react/hooks": "off",
				"react/immutability": "off",
				"react/incompatible-library": "off",
				"react/invariant": "off",
				"react/preserve-manual-memoization": "off",
				"react/purity": "off",
				"react/refs": "off",
				"react/rules-of-hooks": "off",
				"react/set-state-in-effect": "off",
				"react/set-state-in-render": "off",
				"react/static-components": "off",
				"react/unsupported-syntax": "off",
				"react/use-memo": "off",
				"react/void-use-memo": "off"
			}
		}
	]
}
